{
	# ============================================================
	# Nomad Flotilla - design-type lineage tint. A desaturated
	# bronze/tan: a migrant fleet, not a bright faction.
	# ============================================================
	"designTypeColors": {
		"Nomad": [176, 148, 106, 255],
	},

	"plugins": {},

	# ============================================================
