	# path (hullmod sprites through hull_mods.csv, special-item icons through special_items.csv)
	# needs no entry. Intel and point icons under "icons", intel and Work illustrations under
	# "illustrations".
	# ============================================================
	"graphics": {
		# The Management button's plate extension renders at RUNTIME from the game's own
		# "ui"/"tripad_button_holder" sprite; no composed PNG ships.
		# One key, because NomadRefitLunaButton looks it up for the LunaLib refit row's icon. The
		# other four hullmod sprites were registered here and never looked up.
		"nomad": {
			"nomad_member": "graphics/nomad/hullmods/nomad_member.png",
		},
		# Captain's Quarters' own sprite category, which settings.json deep-merges into rather than
		# replaces. The key is cq_f_ plus the furnishing id: their lookup trims only a LEADING
		# "cq_", and this id has none, so the whole id passes through. An unregistered key is not
		# fatal, it just leaves that mod drawing its placeholder outline on the cabin wall.
		"cq": {
			"cq_f_nomad_tally_board": "graphics/nomad/furnishings/nomad_f_tally_board.png",
		},
