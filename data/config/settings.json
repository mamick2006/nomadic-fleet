			"nomad_illus_items": "graphics/nomad/illustrations/nomad_illus_items.png",
			"nomad_work_illus_hydroponics_ring": "graphics/nomad/illustrations/nomad_work_illus_hydroponics_ring.png",
			"nomad_work_illus_forge_vat": "graphics/nomad/illustrations/nomad_work_illus_forge_vat.png",
			"nomad_work_illus_fuel_still": "graphics/nomad/illustrations/nomad_work_illus_fuel_still.png",
			"nomad_work_illus_guild_hall": "graphics/nomad/illustrations/nomad_work_illus_guild_hall.png",
			"nomad_work_illus_bonded_hold": "graphics/nomad/illustrations/nomad_work_illus_bonded_hold.png",
			"nomad_work_illus_bonded_berths": "graphics/nomad/illustrations/nomad_work_illus_bonded_berths.png",
			"nomad_work_illus_chartroom": "graphics/nomad/illustrations/nomad_work_illus_chartroom.png",
			"nomad_work_illus_quiet_running": "graphics/nomad/illustrations/nomad_work_illus_quiet_running.png",
			"nomad_work_illus_civilian_band_watch": "graphics/nomad/illustrations/nomad_work_illus_civilian_band_watch.png",
			"nomad_work_illus_wayfinding_loft": "graphics/nomad/illustrations/nomad_work_illus_wayfinding_loft.png",
			"nomad_work_illus_tug_cradles": "graphics/nomad/illustrations/nomad_work_illus_tug_cradles.png",
			"nomad_work_illus_watch_officers": "graphics/nomad/illustrations/nomad_work_illus_watch_officers.png",
			"nomad_work_illus_militia_gunners": "graphics/nomad/illustrations/nomad_work_illus_militia_gunners.png",
			"nomad_work_illus_damage_control_watch": "graphics/nomad/illustrations/nomad_work_illus_damage_control_watch.png",
			"nomad_work_illus_pride_of_home": "graphics/nomad/illustrations/nomad_work_illus_pride_of_home.png",
			"nomad_work_illus_round_the_clock_yards": "graphics/nomad/illustrations/nomad_work_illus_round_the_clock_yards.png",
			"nomad_work_illus_storm_rider_rig": "graphics/nomad/illustrations/nomad_work_illus_storm_rider_rig.png",
			"nomad_work_illus_long_ward": "graphics/nomad/illustrations/nomad_work_illus_long_ward.png",
