	# ============================================================
	# BALANCE CONSTANTS. All nomad_-prefixed. Tune numbers HERE.
	# ============================================================

	# --- Difficulty. The active mode is a LunaLib Radio (nomad_difficulty) when LunaLib
	# is installed; this is the fallback default when it isn't. One of Auto, Survival, Normal or
	# Story. Auto is Survival in a game started in Survival Mode and Normal otherwise, decided each
	# time the difficulty is read. Any other name reads as Auto. ---
	"nomad_difficulty_default": "Auto",
	"nomad_yield_mult_override": 1.0,
	# The Foundry's own multiplier (the LunaLib nomad_autoforge_yield_mult field when LunaLib is
	# installed; this is the fallback without it). It scales the Foundry production made a month, and
	# the materials go by the unit of Foundry production, so the materials for a job are the same at
	# every setting and only build time changes.
	"nomad_autoforge_yield_mult_override": 1.0,

	# --- Difficulty multipliers. Normal difficulty and Story difficulty each multiply global
	# efficiency, and each asks less of Basic Needs (nomad_bn_normal_difficulty_want_mult and
	# nomad_bn_story_difficulty_want_mult, in the Basic Needs block). Global efficiency scales what
	# a Work uses along with what it makes, so neither makes a chain thriftier. Colony items read
	# the same at every difficulty (nomad_item_effect_mult_normal_difficulty 1.0). ---
	"nomad_item_effect_mult_survival": 1.0,
	"nomad_item_effect_mult_normal_difficulty": 1.0,
	# Normal difficulty's multiplier on global efficiency. Survival's is 1.0.
	"nomad_normal_difficulty_efficiency_mult": 1.25,
	# Story difficulty's extra multiplier, on top of Normal difficulty's and not in place of it, so
	# Story difficulty runs at 1.25 x 1.25 = 1.5625.
	"nomad_story_difficulty_efficiency_mult": 1.25,
	# In Story difficulty a store reserves this share of the Space it otherwise would (see Store
	# targets).
	"nomad_story_difficulty_storage_space_mult": 0.5,
	# Under 100% global efficiency a Work draws its whole inputs and makes less from them, down to
	# this efficiency. Below it the draw falls with efficiency / floor, so a Flotilla at a low Basic
	# Needs level does not burn whole inputs for almost nothing. 0.75 = at 0.5 a Work makes half
	# and draws 0.6667.
	"nomad_efficiency_waste_floor": 0.75,

	# --- Player handicaps, all neutral by default ---
	# Multiplies every Nomad hullmod's ordnance point cost. REBALANCE HERE, never by editing the
	# LunaSettings.csv default: LunaLib persists its defaults per install and goes on serving the stored
	# value, so a changed default reaches nobody who has already run the mod.
	"nomad_op_cost_mult": 1.0,
	# The three optional ship penalties, applied by every Nomad hullmod to the ship carrying it. The
	# toggles are LunaLib rows, and the three false keys are their defaults without LunaLib. The other
	# three are the magnitudes each toggle applies, so a retune moves the number without touching a
	# LunaLib default. The percentages in the three LunaSettings.csv descriptions restate them, so a
	# retune here needs the same change in those descriptions.
	"nomad_nerf_speed": false,
	"nomad_nerf_rof": false,
	"nomad_nerf_cr": false,
	"nomad_nerf_speed_mult": 0.85,
	"nomad_nerf_rof_mult": 0.85,
	# Subtracted from max CR on the 0..1 scale: 0.15 is the 15 points a d-mod tooltip renders as "15%".
	"nomad_nerf_cr_penalty": 0.15,

	# --- Residents. Growth and leaving are set by the Basic Needs level (the Basic Needs block).
	# While the Flotilla is paused, this share of its residents leaves each month. ---
	"nomad_paused_decay": 0.30,

	# --- The Brokerage's sales. It sells what the Sell and Sell cargo flags allow at this share of
	# base price, which keeps every sale worse than hauling the goods to a market yourself. What it
	# pays in credits and how many units it sells a month are its rows in
	# data/config/nomad/nomad_work_sizes.csv. ---
	"nomad_credits_sale_price_frac": 0.60,
	# In a game started in Survival Mode, the brokerage sells at (1 minus ext_normalTariff minus survival_gap) of
	# base price instead of price_frac. Survival's tariff is 40% where a normal game's is 30%, so a market
	# sale there nets 0.60 of base, and a 0.60 brokerage would no longer be the worse deal. The gap is the
	# one a normal game has (0.70 against 0.60), so vanilla's Survival tariff gives 0.50, and a mod that
	# changes the tariff moves the fraction with it. Unused when the player turns off
	# nomad_survival_adjustments.
	"nomad_credits_sale_survival_gap": 0.10,
	# The Brokerage's own credits get this share of what global efficiency adds above 100%: at 0.5
	# and 130% global efficiency they are paid at 115%. 0 gives them none of the increase and 1
	# all of it, as a production Work's output gets. Below 100% they follow global efficiency in
	# full, and how many units the Brokerage sells always does.
	"nomad_brokerage_bonus_share": 0.5,
	# Taking residents out as crew leaves at least this many aboard.
	"nomad_crew_extract_reserve": 10,
	"nomad_marines_target_default": 100,

	# --- Hullmod percentages. Each ship carries its OWN two dedication percentages, set on the refit screen
	# and stored on the ship's variant. The keys here are the values a fresh
	# conversion starts at AND the lowest a ship may be set to: a converted ship gets the per-ship Works
	# bonuses whatever it gives, so raising these raises the price of membership and lowering them cheapens
	# it. The flagship's ship effects are IDENTICAL to a member's, off these same keys; its
	# privileges are a discounted OP cost and carrying the Works and colony items.
	# Cargo percentage becomes Space, quarters percentage becomes Berths, and 100% quarters leaves the
	# skeleton crew aboard. ---
	"nomad_dedication_default_cargo": 30,
	"nomad_dedication_default_quarters": 30,
	"nomad_member_supplies_penalty": 10,

	# --- Per-commodity base prices (credits/unit; vanilla commodities.csv). In play the mod uses
	# the game's own prices instead, and Survival Mode's prices in a Survival Mode game. ---
	"nomad_price_food": 20,
	"nomad_price_organics": 30,
	"nomad_price_domestic_goods": 50,
	"nomad_price_luxury_goods": 100,
	"nomad_price_supplies": 100,
	"nomad_price_fuel": 25,
	"nomad_price_metals": 30,
	"nomad_price_rare_metals": 200,
	"nomad_price_ore": 10,
	"nomad_price_rare_ore": 75,
	"nomad_price_volatiles": 250,
	"nomad_price_heavy_machinery": 150,
	"nomad_price_hand_weapons": 500,
	"nomad_price_drugs": 200,
	"nomad_price_organs": 300,
	# A resident, for a Work that consumes residents: the game's price for one crew, which is
	# what moving a resident to your crew costs. Residents are not a commodity, so the game has
	# no price to replace this one with.
	"nomad_price_residents": 50,
	"nomad_price_marines": 200,

	# --- Mining. The Mining Rig's rates are its rows in data/config/nomad/nomad_work_sizes.csv:
	# 360 credits of each raw a month for 100 Space at a 1.0x deposit, times the deposit's tier
	# (0.5x sparse to 3.0x ultrarich), for every raw the body has. ---
	# How close, in campaign map units, the fleet must be to a body to mine it.
	"nomad_mining_radius": 333,

	# --- The Foundry (the autoforge). A queued job costs Foundry production equal to its
	# value, and the head of the queue banks Foundry production until it is paid. How much the
	# Foundry makes a month and the materials each unit takes are its rows in data/config/nomad/nomad_work_sizes.csv.
	# There is deliberately NO nomad_autoforge_min_days key: a floor on the picker's estimate alone
	# would disagree with the build time, so both use one calculation.
	# d-mods base 4 / corrupted 2 / pristine 1. ---
	"nomad_autoforge_dmod_base": 4,
	"nomad_autoforge_dmod_corrupted": 2,
	"nomad_autoforge_dmod_pristine": 1,

	# --- Detachment. A detached Flotilla pays its ships' monthly supplies from its own store. ---
	# A detached Flotilla waits at the nearest surveyed mineable body within this many map units.
	# If there is none, it waits where it detached.
	"nomad_split_anchor_body_range": 2500,

	# --- Works. A Work's Space, staff, cost and what each size does are rows of
	# data/config/nomad/nomad_work_sizes.csv. What is left here is how
	# long a build takes, what scrapping pays back, and the effect numbers no row carries. A row's
	# params column wins over any of the effect numbers. ---
	"nomad_work_build_days": 15,
	"nomad_work_scrap_refund": 0.25,
	# Dormitory adds this many berths for each Space it takes.
	"nomad_work_dormitory_mult": 3.0,
	"nomad_work_tug_bay_burn": 1,                 # +1 fleet burn
	"nomad_work_officer_academy_bonus": 1,             # +1 maximum officers
	"nomad_work_storm_shielding_workshop_resist_mult": 0.5,    # hyperspace-storm / corona CR damage x0.5
	"nomad_work_hospital_crew_return_frac": 0.25,    # 25% of crew lost in battle return as residents
	"nomad_work_raid_training_ground_marine_xp_monthly": 200,    # marine XP granted per month
	"nomad_work_passenger_terminal_stability": 2,            # +2 stability at the orbited player colony
	"nomad_work_passenger_terminal_intake_per_month": 3,     # residents joining the Flotilla per month while orbiting
	"nomad_work_passenger_terminal_radius": 500,             # how close to the colony counts as "orbiting"
	"nomad_work_purchasing_office_rebate_frac": 0.02, # 2% credit rebate on purchases at markets
	"nomad_work_watch_stations_ppt_pct": 25,      # +25% peak CR duration on nomad ships
	"nomad_work_tinkering_facilities_stat_pct": 5,    # +5% each: turn rate, top speed, flux dissipation, flux capacity

	# --- Colony-item effects. Magnitudes apply IDENTICALLY at every difficulty
	# (nomad_item_effect_mult_normal_difficulty 1.0). Nanoforge
	# supplies bonuses: pristine replaces corrupted (no stack). ---
	"nomad_item_soil_nanites_food": 0.50,
	# Both of these are input-ratio cuts, not yield bonuses. The Catalytic Core cuts the Refinery's two
	# ratios (metals<-ore, rare_metals<-rare_ore) and the Synchrotron cuts the Fuel Plant's volatiles.
	"nomad_item_catalytic_core_ore_input": 0.20,
	"nomad_item_synchrotron_fuel_input": 0.40,
	# The two nanoforges are SPREAD APART deliberately: the gap between corrupted and
	# pristine is what spreads the late game from the mid game on the supplies line. Items read
	# identically in both modes, so the gap works through the flat magnitudes alone.
	"nomad_item_corrupted_nanoforge_supplies": 0.10,
	# Pristine (+45%) is the dominant late-game supplies carrier, well above corrupted's +10%.
	"nomad_item_pristine_nanoforge_supplies": 0.45,
	# The nanoforges ALSO raise the AUTOFORGE yield (Corrupted +10%, Pristine +20%),
	# additive with the Cryoarithmetic Engine's autoforge bonus (pristine wins over corrupted,
	# no stack; mode-independent per the header above). The SUPPLY-yield bonuses above are separate
	# effects: a Pristine supply bonus cut toward +20%
	# would gut the late-game supplies carrier.
	"nomad_item_corrupted_nanoforge_autoforge": 0.10,
	"nomad_item_pristine_nanoforge_autoforge": 0.20,
	# The Pristine Nanoforge also gives a +3% GLOBAL
	# production-efficiency bonus, additive in the same one group as the Fullerene +3% and Cryoarithmetic +2%
	# bonuses below (with the Hypershunt Tap, all four installed fold to +13%). FLAT / mode-independent like those two. Pristine-only;
	# corrupted gets no efficiency effect (nothing to win over, so the one-nanoforge-slot rule is moot here).
	"nomad_item_pristine_nanoforge_efficiency": 0.03,
	# Biofactory: a food OUTPUT bonus (adds with soil nanites' bonus), alongside its luxury boost
	# (food takes no input, so an input cut would be meaningless).
	"nomad_item_biofactory_food": 0.15,
	"nomad_item_biofactory_luxury": 0.40,
	# Two more Biofactory lines: it removes the Organ Harvester's resident input (the share removed,
	# 1 is all of it, an input cut like the Catalytic Core's) and adds to the Cloning Vats' yield.
	"nomad_item_biofactory_harvester_residents": 1.0,
	"nomad_item_biofactory_vats": 0.25,
	# The Fullerene Spool adds 5% to the Flotilla's Space (nomad_item_fullerene_spool_space, on the
	# ships' figure or the one frozen at a split) and +3% global efficiency, additive with the
	# Cryoarithmetic +2% in one group.
	"nomad_item_fullerene_spool_efficiency": 0.03,
	"nomad_item_fullerene_spool_space": 0.05,
	# The Orbital Fusion Lamp berth bonus is FLAT (+10% berths in BOTH modes; itemEffectMult is not
	# applied). Berths are a CAPACITY (housing)
	# effect, not a production/yield effect, so the difficulty's multiplier does not scale them.
	"nomad_item_orbital_fusion_lamp_berths": 0.10,
	# Plasma Dynamo: a single-resource booster, pitched just above Mantle Bore's general mining lift
	# because it covers volatiles alone.
	"nomad_item_mantle_bore_mining": 0.40,
	"nomad_item_plasma_dynamo_volatiles": 0.50,
	# Cryoarithmetic: autoforge speed +20%, plus +2% global efficiency (above).
	"nomad_item_cryoarithmetic_autoforge_speed": 0.20,
	# The four global-efficiency keys are named nomad_item_<item id>_efficiency, because which items
	# raise global efficiency comes from data/config/nomad/nomad_items.csv and each row's value is read
	# under that key. These win over the row, so this file stays where the numbers are tuned.
	"nomad_item_cryoarithmetic_engine_efficiency": 0.02,
	"nomad_item_coronal_portal_efficiency": 0.05,
	"nomad_item_dealmaker_autoforge_cost": 0.10,
	# The Dealmaker Holosuite raises the credits the Brokerage pays (mode-independent, like every
	# item magnitude), beside its discount on the Foundry's materials above.
	"nomad_item_dealmaker_credits": 0.20,
	"nomad_item_drone_replicator_staff": 0.50,
	# The Combat Drone Replicator also lifts the Military Fabricator's heavy armaments yield, half
	# the game's +50% on ground defences. A yield line: the Fabricator uses 25% more inputs too.
	"nomad_item_drone_replicator_armaments": 0.25,
	# The AI cores cut the staff every Work needs: the stronger the core, the bigger the cut.
	"nomad_item_core_staff_alpha": 0.07,
	"nomad_item_core_staff_beta": 0.05,
	"nomad_item_core_staff_gamma": 0.03,

	# ============================================================
	# Content this mod adds to OTHER mods' tables. Both numbers are
	# balanced here, on this mod's own surface, because both effects
	# are Flotilla effects; the other mod supplies the roster the
	# content sits in and nothing else.
	# ============================================================

	# The Flotilla Tally Board, a Captain's Quarters furnishing: +1% GLOBAL efficiency,
	# additive in the same group as the four colony items (+13% with all four, +14% with
	# the board as well). The smallest contributor in that group by design, below the
	# Cryoarithmetic Engine's +2%: it is a cabin fitting and they are Domain artifacts.
	"nomad_cq_tally_board_efficiency": 0.01,

	# The board's whole acquisition path, and no code on either side of it. Captain's
	# Quarters polls each configured flag and grants the furnishing when it turns true;
	# settings.json deep-merges, so this adds an entry to that mod's own map rather than
	# replacing it. $nomad_founded is set by the economy tick once the Flotilla exists.
	"cq_quest_rewards": {
		"$nomad_founded": "nomad_tally_board",
	},

	# --- Founding & migrant pickup. Founding residents = min(founding_residents,
	# founding_berth_frac x current berths): a 25 cap, and small fleets seed smaller. ---
	"nomad_founding_residents": 25,
	"nomad_founding_berth_frac": 1.0,
	# A new Flotilla's target for each of the twelve stores every Flotilla keeps (the three
	# contraband stores start at 0).
	"nomad_founding_store_target": 5,
	# Space every Flotilla has beyond what its ships and items give, for each of those twelve
	# goods: 5 x 12 = 60 (Capacity.foundingSpace). Plain Space, and a target never changes it.
	"nomad_founding_space_per_good": 5,
	"nomad_pickup_min": 1,
	"nomad_pickup_base": 10,
	"nomad_pickup_size_coef": 0.0001,
	"nomad_pickup_pop_frac": 0.05,
	# Per-COLONY cooldown: a market offers migrants at most once every this many days
	# (stored per market as $nomad_lastPickupTs). 6 months.
	"nomad_pickup_cooldown_days": 180,

	# --- The fleet's own reserve. A store's In flag fills it from fleet cargo and the Sell cargo
	# flag sells from fleet cargo, both only from what the fleet holds above this many days of its
	# own supplies and this many light-years of jump fuel. ---
	"nomad_autotransfer_reserve_days_supplies": 30,
	"nomad_autotransfer_reserve_ly_fuel": 10,

	# --- Basic Needs. The Space no Work or store uses and the residents no Work employs belong
	# to Basic Needs. At the Normal level it wants this much Space and this share of residents for
	# each resident aboard; Normal difficulty and Story difficulty want that times their multiplier.
	# Provision is what it has against what the Normal level wants, the lower of the Space figure
	# and the residents figure. ---
	"nomad_bn_space_per_resident": 1.0,
	"nomad_bn_staff_per_resident": 0.35,
	"nomad_bn_normal_difficulty_want_mult": 0.80,
	"nomad_bn_story_difficulty_want_mult": 0.64,
	# What Basic Needs requires falls as the Flotilla develops. Each size of each built Work that
	# is not mothballed, disabled or suspended lowers it by nomad_bn_tier_relief, and so does each
	# installed item (nomad_bn_item_tiers sizes an item), up to nomad_bn_tier_relief_cap together.
	# A row's needs_raise raises it by that many sizes' worth, and needs_amenity lowers it, both
	# outside the cap. The factor never goes under nomad_bn_requirement_floor. The difficulty's
	# multiplier above multiplies the result. 0 relief turns the rule off.
	"nomad_bn_tier_relief": 0.01,
	"nomad_bn_tier_relief_cap": 0.40,
	"nomad_bn_item_tiers": 1,
	"nomad_bn_requirement_floor": 0.25,
	# One block per level: the provision the level starts at, the global efficiency it sets, the
	# share of residents that leave each month, and the growth each year.
	# Global efficiency is the level's figure, times 1 plus what the items and the Guild Hall add,
	# times the difficulty's multiplier. Every point of it scales what a Work uses as well as what
	# it makes, Normal difficulty's and Story difficulty's included, so no bonus makes a chain
	# thriftier.
	# The three levels above Normal add 5% each. At 10% each every colony cap still holds.
	# What bounds the step is the stores: a minimum target is measured at
	# Opulent's efficiency, and with Opulent above 123% the Survival Mode start fleet's size 1
	# pair no longer leaves Basic Needs the Space for Normal.
	"nomad_bn_nonexistent_provision": 0.0,
	"nomad_bn_nonexistent_efficiency": 0.0,
	"nomad_bn_nonexistent_leave_per_month": 0.10,
	"nomad_bn_nonexistent_growth_per_year": 0.0,
	"nomad_bn_decrepit_provision": 0.40,
	"nomad_bn_decrepit_efficiency": 0.30,
	"nomad_bn_decrepit_leave_per_month": 0.04,
	"nomad_bn_decrepit_growth_per_year": 0.0,
	"nomad_bn_spartan_provision": 0.70,
	"nomad_bn_spartan_efficiency": 0.70,
	"nomad_bn_spartan_leave_per_month": 0.0,
	"nomad_bn_spartan_growth_per_year": 0.0,
	"nomad_bn_normal_provision": 1.00,
	"nomad_bn_normal_efficiency": 1.00,
	"nomad_bn_normal_leave_per_month": 0.0,
	"nomad_bn_normal_growth_per_year": 0.02,
	"nomad_bn_nice_provision": 1.25,
	"nomad_bn_nice_efficiency": 1.05,
	"nomad_bn_nice_leave_per_month": 0.0,
	"nomad_bn_nice_growth_per_year": 0.04,
	"nomad_bn_lavish_provision": 1.60,
	"nomad_bn_lavish_efficiency": 1.10,
	"nomad_bn_lavish_leave_per_month": 0.0,
	"nomad_bn_lavish_growth_per_year": 0.06,
	"nomad_bn_opulent_provision": 2.00,
	"nomad_bn_opulent_efficiency": 1.15,
	"nomad_bn_opulent_leave_per_month": 0.0,
	"nomad_bn_opulent_growth_per_year": 0.08,

	# --- The Fuel Plant in a game started in Survival Mode, with this mod's adjustments on. The mode
	# triples fuel's price and leaves volatiles alone, which would turn the Fuel Plant's 3.5 credits of
	# margin a fuel into 53.5. So the Fuel Plant uses more volatiles there: for each 1.0 the mode adds to
	# fuel's price multiplier, this many times its normal amount more. The number is fuel's price
	# over the price of the volatiles one fuel takes, 25 / (250 x 0.086) = 1.1628, which keeps the
	# margin where it was. At the mode's x3 the Fuel Plant uses 1 + 2 x 1.1628 = 3.3256 times its normal
	# volatiles, 0.286 a fuel. ---
	"nomad_survival_fuel_plant_input_step": 1.1628,

	# --- Store targets. A good reserves this much Space per unit of its target or its stock,
	# whichever is larger. Story difficulty multiplies it by
	# nomad_story_difficulty_storage_space_mult. ---
	"nomad_store_space_per_unit": 1.0,

	# --- Remote mining. With the Mining Rig's toggle on, the Rig mines the best surveyed body in
	# the system at tier_mult times its deposit tier, never above cap. A system with no such body
	# and an asteroid belt or field counts as one ore deposit of asteroid_tier. Turning the toggle
	# on takes on_days; turning it off is at once. ---
	"nomad_mining_remote_tier_mult": 0.2,
	"nomad_mining_remote_cap": 0.4,
	"nomad_mining_remote_asteroid_tier": 0.5,
	"nomad_mining_remote_on_days": 10,

	# --- The support limit. A Flotilla runs this many Fleet, Combat and Fortune Works at once,
	# one more from the head count below, and one more from each doubling of that head count,
	# without end: 200, 400, 800, 1,600 and so on. 0 turns the steps off. The Works past the
	# limit are disabled, lowest in the staffing order first: they reserve their Space, take no staff
	# and have no effect. Economy and Capacity Works are not counted. The limit is read at
	# each economy tick. ---
	"nomad_support_limit_base": 3,
	"nomad_support_limit_first_at": 200,

	# --- A Work behind a number of residents (a residents row in nomad_work_prereqs.csv) starts at
	# that number, and once it runs it keeps running until the Flotilla is this share under it:
	# 0.05 has a 2,000 row stop under 1,900. ---
	"nomad_prereq_residents_slack": 0.05,
}
