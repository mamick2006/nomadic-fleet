			"nomad_intel_paused": "graphics/nomad/icons/nomad_intel_paused.png",
			"nomad_intel_detached": "graphics/nomad/icons/nomad_intel_detached.png",
			"nomad_autoforge_production": "graphics/nomad/icons/nomad_autoforge_production.png",
			"nomad_credits": "graphics/nomad/icons/nomad_credits.png",
		},
		"illustrations": {
			"nomad_illus_flotilla": "graphics/nomad/illustrations/nomad_illus_flotilla.png",
			"nomad_illus_habring": "graphics/nomad/illustrations/nomad_illus_habring.png",
