			"nomad_work_illus_militia_dedication": "graphics/nomad/illustrations/nomad_work_illus_militia_dedication.png",
			"nomad_work_illus_tinkering_facilities": "graphics/nomad/illustrations/nomad_work_illus_tinkering_facilities.png",
			"nomad_work_illus_refinery": "graphics/nomad/illustrations/nomad_work_illus_refinery.png",
		},
